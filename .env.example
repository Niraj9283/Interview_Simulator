# ==============================================================================
# MockMate AI - Production-Ready Environment Configuration Template
# COPY THIS FILE TO:
#   - .env.local (Frontend - Next.js)
#   - backend/.env (Backend - FastAPI)
#
# NEVER COMMIT .env or .env.local TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# Public Application URL (Used for constructing verification & reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL (Client-safe public reverse proxy endpoint)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-Side Internal API URL (Used by Next.js Server Components and Auth Proxy)
INTERNAL_API_URL=http://localhost:8000

# Optional Public Error Monitoring DSN (No secret tokens exposed)
NEXT_PUBLIC_SENTRY_DSN=

# Server-Side Only API Keys (Never prefixed with NEXT_PUBLIC_)
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_API_KEY=your_whisper_api_key_here

# Resend Email Delivery Service (Account Verification, Password Reset, Feedback)
RESEND_API_KEY=re_your_resend_api_key_here
FEEDBACK_TO_EMAIL=support@mockmate.ai
FEEDBACK_FROM_EMAIL=MockMate AI <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 2. Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Application Environment (production | staging | development)
ENVIRONMENT=production

# Public application base URL for constructing emails
APP_URL=http://localhost:3000

# Debug Mode: ALWAYS set to false in production to prevent stack trace leaks
DEBUG=false

# Cryptographic Salt & Session Secrets (Generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_random_32_byte_hex_secret_key_here
JWT_SECRET=generate_a_random_32_byte_hex_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Headless Admin API Key (For automated runners or CI/CD pipelines)
ADMIN_API_KEY=generate_a_strong_admin_api_key_here

# CORS Allowed Origins (Comma-separated list; do NOT use wildcard '*' with credentials)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection (Leave empty or sqlite:///... for SQLite; provide postgresql://... for PostgreSQL)
DATABASE_URL=

# Distributed Rate Limiting (Leave empty for in-memory fallback; provide redis://... in production)
REDIS_URL=
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Automated Database Backup Configuration
BACKUP_DIR=backend/data/backups
BACKUP_RETENTION_DAYS=7

# Error Monitoring (Sentry DSN for backend exception reporting)
SENTRY_DSN=

# Email Sender for Authentication System
EMAIL_FROM=MockMate AI <security@mockmate.ai>

# Upload Security Guards (in bytes, 10MB = 10485760)
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_TEXT_INPUT_LENGTH=50000

# Chroma Vector Database Safety
CHROMA_ALLOW_RESET=false

# OpenAPI Swagger Documentation (Disable in production for security through reduction)
DOCS_ENABLED=false
